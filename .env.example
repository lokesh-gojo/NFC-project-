# Nexora Technologies - Client Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# If these variables are not provided, Nexora will seamlessly operate in demo/local mode with pre-seeded data for Cafe Aroma.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_APP_URL=http://localhost:5173

